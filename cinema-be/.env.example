PORT=
MONGODB_URI=
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=

# How often (ms) the background sweep scans for expired seat holds/pending bookings/issued
# tickets. Optional — defaults to 30 seconds when unset. How long a HELD seat itself stays
# reserved is the BOOKING_HOLD_TIME business setting (System Configuration, Ticket 27) — see
# SUPER_ADMIN > System Configuration in the app, not an env var.
SEAT_HOLD_SWEEP_INTERVAL_MS=30000

# Cloudinary is used to host uploaded movie poster images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_ENVIRONMENT_VARIABLE=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=
# Optional: where MoMo returns the browser after an in-seat F&B payment (Ticket 49).
# Defaults to /InSeat/PaymentResult on the MOMO_REDIRECT_URL site.
MOMO_INSEAT_REDIRECT_URL=

# Optional: secret that signs the per-seat QR codes for in-seat ordering (Ticket 49). Falls back to
# JWT_SECRET. Changing it invalidates every printed seat QR.
SEAT_QR_SECRET=
